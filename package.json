{
  "name": "naiwa-survivors",
  "version": "0.1.0",
  "private": true,
  "description": "奶蛙幸存者：支持手机触屏与电脑键盘的十二波自动攻击生存游戏。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/serve.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "licenses": "node scripts/dependency-notices.mjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "@playwright/test": "1.56.1",
    "sharp": "0.35.5"
  }
}
